<programa> ::= "Kilala" <instrucciones> "Fin"

<instrucciones> ::= <instruccion> <instrucciones> | ε

<instruccion> ::= <declaracion_variable>
                | <declaracion_constante>
                | <asignacion>
                | <funcion_declaracion>
                | <condicional>
                | <bucle_while>
                | <bucle_for>
                | <operacion>
                | <retornar>
                | <detener>

<declaracion_variable> ::= "Bakusaiga" <tipo> <identificador> "=" <valor> ";"
<declaracion_constante> ::= "Tetsusaiga" <tipo> <identificador> "=" <valor> ";"
<asignacion> ::= <identificador> "=" <valor> ";"

<tipo> ::= "Miroku" | "Sesshomaru" | "Sango"
<valor> ::= <numero> | <cadena> | <identificador>

<funcion_declaracion> ::= "Shippo" <identificador> "(" <parametro> ")" "{" <instrucciones> "}"
<parametro> ::= <tipo> <identificador> | ε

<condicional> ::= "Kagome" "(" <expresion_logica> ")" "{" <instrucciones> "}"
                  <condicional_sino>

<condicional_sino> ::= "Kikyo" "{" <instrucciones> "}"
                     | "Naraku" "(" <expresion_logica> ")" "{" <instrucciones> "}" <condicional_sino>
                     | ε

<bucle_while> ::= "Inuyasha" "(" <expresion_logica> ")" "{" <instrucciones> "}"

<bucle_for> ::= "Myoga" "(" <asignacion> <expresion_logica> ";" <incremento> ")" "{" <instrucciones> "}"
<incremento> ::= <identificador> "+=" <numero> | <identificador> "-=" <numero>

<operacion> ::= "Hiraikotsu" "(" <expresion_aritmetica> ")" ";"
<retornar> ::= "Tenseiga" <valor> ";"
<detener> ::= "Jaken" ";"

<expresion_logica> ::= <valor> <operador_relacional> <valor>
<operador_relacional> ::= "<" | ">" | "<=" | ">=" | "==" | "!="

<expresion_aritmetica> ::= <valor> <operador_aritmetico> <valor>
<operador_aritmetico> ::= "+" | "-" | "*" | "/" | "%"

<numero> ::= [0-9]+ ("." [0-9]+)?
<cadena> ::= "\"" [^\"]* "\""
<identificador> ::= [a-zA-Z_][a-zA-Z0-9_]{0,15}
